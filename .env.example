# Copy this file to .env and replace every placeholder. The real .env is ignored by Git.

# Admin UI language (build-time): zh-TW / zh-CN / en / ja / ko
LITELLM_UI_LANG=zh-TW

# LiteLLM master key. Use a long, random value beginning with sk-.
LITELLM_MASTER_KEY=sk-replace-with-a-long-random-secret

# Salt used to encrypt virtual keys. Do not change it after keys have been created.
LITELLM_SALT_KEY=replace-with-another-long-random-secret

# Admin UI credentials
UI_USERNAME=admin
UI_PASSWORD=replace-with-a-strong-password

# PostgreSQL settings used by docker-compose.yml
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=litellm

# Password for the Redis coordination cache in docker-compose.yml. LiteLLM shares
# rate limits, budgets, router cooldowns and cache invalidation through it; the
# connection is wired up in config/config.example.yaml under
# general_settings.coordination_redis.
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Provider key used by the included Ollama Cloud example.
# Replace this and edit config/config.yaml when using another provider.
OLLAMA_API_KEY=replace-with-your-ollama-api-key

# DEBUG / INFO / WARNING / ERROR
LITELLM_LOG=INFO
