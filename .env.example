# 複製成 .env 後填入自己的值。.env 已被 .gitignore 排除，不會進版控。

# LiteLLM 主金鑰（管理用，等同最高權限，請用長隨機字串）
LITELLM_MASTER_KEY=sk-請換成你自己的長隨機字串

# 加密虛擬金鑰用的 salt，設定後不可再更改（否則既有金鑰全部失效）
LITELLM_SALT_KEY=請換成另一組長隨機字串

# 管理介面登入帳密
UI_USERNAME=admin
UI_PASSWORD=請換成強密碼

# PostgreSQL（docker-compose 會用這三個變數建資料庫）
POSTGRES_USER=litellm
POSTGRES_PASSWORD=請換成強密碼
POSTGRES_DB=litellm

# 上游供應商 API Key（本專案接 Ollama Cloud，換別家就改 config/config.yaml）
OLLAMA_API_KEY=請換成你的 Ollama API Key

# 日誌層級：DEBUG / INFO / WARNING / ERROR
LITELLM_LOG=INFO
